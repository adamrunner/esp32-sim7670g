CONFIG_IDF_TARGET="esp32s3"

# Waveshare ESP32-S3-SIM7670G-4G: 16MB quad flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA: a new image boots pending-verify and must call
# esp_ota_mark_app_valid_cancel_rollback() after its self-test, or the
# bootloader reverts to the previous slot on the next reset.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Console: UART0 primary, USB-Serial-JTAG secondary (IDF default) — logs
# still show on the board's USB-C via the secondary console.

# Roomier HTTP headers for browser requests
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Keep the socket budget explicit: the HTTP server uses seven slots including
# its internal sockets, leaving three for MQTT, OTA, and transient clients.
CONFIG_LWIP_MAX_SOCKETS=10

# The fallback SoftAP is a local control link. Do not add an implicit DNS
# server to its DHCP offers; wifi.c also disables the router and explicit DNS
# offer bits before the DHCP server starts.
# CONFIG_LWIP_DHCPS_ADD_DNS is not set

# Cellular data: lwIP PPP client over UART to the SIM7670G (esp_modem)
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_UART_ISR_IN_IRAM=y

# esp_modem C API copies AT responses through a bounded buffer; match the
# web UI AT console's response size
CONFIG_ESP_MODEM_C_API_STR_MAX=2048

# OTA downloads over PPP: the IDF default receive window (4*MSS = 5760) caps
# long-RTT cellular transfers at ~17 KB/s (5760 B / ~330 ms RTT). 8*MSS =
# 11520 covers the link's bandwidth-delay product (~34 KB/s * ~330 ms ≈
# 11 KB), i.e. the UART becomes the bottleneck again, without queueing more
# than ~11 KB per socket. Bump the recv mailbox to match: 8 MSS-sized
# segments in flight would overflow the default 6-slot mbox and force
# retransmits (entries are pbuf pointers, so 16 is cheap).
CONFIG_LWIP_TCP_WND_DEFAULT=11520
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# Release TLS TX/RX buffers whenever mbedTLS has finished sending or the upper
# layer has consumed received data. Keep IDF's 16 KB input / 4 KB output limits
# so Cloudflare and MQTT brokers may still use standard full-size TLS records.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# microSD data logging: FATFS long filenames (stored on the heap) so date- or
# timestamp-based names like "2026-07-14.csv" aren't truncated to 8.3.
CONFIG_FATFS_LFN_HEAP=y

# 8 MB octal PSRAM (LOCAL_WEBUI_STABILITY_PLAN.md Phase B). Internal RAM is
# the binding constraint on this build: the 2026-08-17 field capture recorded
# an all-time internal low of 840 bytes and a 2,560-byte largest free block,
# inside the band where TLS allocations have historically failed. The external
# pool absorbs the large, non-DMA allocations so internal RAM keeps headroom.
#
# Nothing in the IDF 5.5 bootloader depends on CONFIG_SPIRAM (PSRAM is brought
# up by the app at startup), so this reaches the field device by an app-only
# OTA update without reflashing the bootloader.
CONFIG_SPIRAM=y
# Waveshare ESP32-S3-SIM7670G-4G carries an ESP32-S3R8: in-package octal
# PSRAM. Confirm against `esptool.py flash_id` ("Embedded PSRAM 8MB") and the
# boot line before trusting a build on hardware — a mode mismatch aborts at
# the memory test below rather than running degraded.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
# Leave the clock at the 40 MHz default; 80 MHz is a separate experiment.
CONFIG_SPIRAM_SPEED_40M=y
# malloc() may return external RAM, so existing allocations benefit without
# code changes.
CONFIG_SPIRAM_USE_MALLOC=y
# Abort at boot on a bad PSRAM bring-up instead of running with silent
# corruption. Costs some startup time; worth it for a vehicle-resident device.
CONFIG_SPIRAM_MEMTEST=y
# Allocations at or below this size still prefer internal RAM (IDF default).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Guaranteed internal pool for DMA, task stacks, and anything needed while the
# SPI cache is down; not handed out to ordinary malloc() (IDF default).
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
#
# Deliberately NOT enabled here — its own evidence-gated measurement, still
# unmeasured (see the Phase B deliverables):
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP is not set

# mbedTLS allocates from PSRAM instead of internal RAM. This is the first
# gated extra, enabled on evidence rather than expectation: with PSRAM on but
# this off, an OTA download under WebUI polling still died with
# mbedtls=0x7f00 (MBEDTLS_ERR_SSL_ALLOC_FAILED) at an internal low of 1,743
# bytes while 8.35 MB of external heap sat free — the TLS handshake allocates
# internally by construction, so PSRAM could not help it. Full evidence in
# docs/LOCAL_WEBUI_STABILITY_PLAN.md, "Phase B OTA and TLS evidence".
#
# Replaces the IDF default CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC. Kept alongside
# CONFIG_MBEDTLS_DYNAMIC_BUFFER above, which is an independent option: it
# controls *when* TLS buffers are allocated, this controls *where*.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
